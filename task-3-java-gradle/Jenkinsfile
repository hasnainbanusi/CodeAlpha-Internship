pipeline {
    agent any

    stages {
        stage('Build and Test') {
            steps {
                sh './gradlew clean build'
            }
        }

        stage('Run Application') {
            steps {
                sh './gradlew run'
            }
        }

        stage('Archive JAR') {
            steps {
                archiveArtifacts artifacts: 'app/build/libs/*.jar',
                                 fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Java Gradle pipeline completed successfully!'
        }
        failure {
            echo 'Java Gradle pipeline failed. Check the console output.'
        }
    }
}
